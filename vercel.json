{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/chat-proxy.ts": {
      "includeFiles": "content/**/*.md",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/atom.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/atom+xml; charset=utf-8" }
      ]
    }
  ]
}
