{
  "compilerOptions": {
    /* Language / emit --------------------------- */
    "target": "ES2022", // matches the syntax Node 22 understands
    "module": "NodeNext", // ESM compatible & allowed with NodeNext resolution
    "moduleResolution": "NodeNext",
    "noEmit": true, // we only type-check locally
    /* Type-safety ------------------------------ */
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // Tests import `./openai-auth.ts` so Node's type stripper can load them.
    // Production imports keep the `.js` specifiers Vercel and NodeNext expect.
    "allowImportingTsExtensions": true
  },
  "include": ["api/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules"]
}
